@inproceedings{bonato2026orderedchaos,
  abbr        = {SC'26},
  type        = {inproceedings},
  author      = {Tommaso Bonato and Ahmad Ghalayini and Nadeen Gebara and Benoit Pit-Claudel and Jiayong Li and Mikhail Khalilov and Luca Piccolboni and Waleed Reda and Pei-Huan Tsai and Tao Ji and Abdul Kabbani and Torsten Hoefler},
  title       = {Ordered Chaos: Towards Adaptive Multipath Load Balancing with Precise Fast Loss Detection},
  year        = {2026},
  month       = {11},
  tags        = {ai;hpc;networking;load balancing;transport},
  arxiv       = {https://arxiv.org/abs/2610.41707},
  doi         = {10.48550/arXiv.2610.41707},
  pdf         = {https://arxiv.org/pdf/2610.41707},
  abstract    = {Ordered Chaos combines adaptive multipath routing with reliable loss recovery at the endpoints. Reactive Subflow Spraying distributes traffic across ordered subflows, while Precise Fast Loss Detection uses ordering and probes to tell packet reordering apart from actual loss within one round-trip time. Simulation and DPU experiments show up to 3x better tail flow completion times, up to 99\% fewer timeout recoveries, and up to 35\% faster collective and training communication.},
  booktitle   = {Proceedings of the International Conference for High Performance Computing, Networking, Storage and Analysis (SC'26)},
  note        = {To appear},
  selected={true}
}

@inproceedings{bonato2026provisioning,
  abbr        = {SC'26},
  type        = {inproceedings},
  author      = {Tommaso Bonato and Amirreza Rastegari and Daniele De Sensi and Timo Schneider and Siyuan Shen and Ales Kubicek and Prabhat Ram and Torsten Hoefler},
  title       = {Provisioning Networks for AI Supercomputers: A Trace-Driven Study of Performance Sensitivity at Unprecedented Scale},
  year        = {2026},
  month       = {11},
  tags        = {ai;hpc;networking;performance;workloads},
  arxiv       = {https://arxiv.org/abs/2610.41700},
  doi         = {10.48550/arXiv.2610.41700},
  pdf         = {https://arxiv.org/pdf/2610.41700},
  abstract    = {We study how AI training and inference depend on network latency, bandwidth, and jitter at scales reaching 4,096 GPUs. By decomposing execution traces and solving linear programs, the analysis explores network configurations while retaining NCCL schedules and application dependencies. Comparisons with hardware measurements and existing simulators validate the method at feasible scales. The resulting performance envelopes help identify both network bottlenecks and upgrades that offer limited benefit.},
  booktitle   = {Proceedings of the International Conference for High Performance Computing, Networking, Storage and Analysis (SC'26)},
  note        = {To appear},
  selected={true}
}

@article{khalilov2026pcm,
  abbr        = {arXiv},
  type        = {article},
  author      = {Mikhail Khalilov and Timo Schneider and Tommaso Bonato and Siyuan Shen and Marcin Chrapek and Yehor Kozyr and Alberto Merino and Rip Sohan and Surendra Anubolu and Mohan Kalkunte and Ahmad Ghalayini and Abdul Kabbani and Torsten Hoefler},
  title       = {PCM: Programmable Congestion Management for Terabit RDMA NICs},
  journal     = {arXiv preprint arXiv:2610.13130},
  year        = {2026},
  month       = {10},
  tags        = {networking;congestion control;load balancing;rdma},
  arxiv       = {https://arxiv.org/abs/2610.13130},
  doi         = {10.48550/arXiv.2610.13130},
  pdf         = {https://arxiv.org/pdf/2610.13130},
  abstract    = {PCM lets congestion-control and load-balancing policies move between RDMA platforms through a common programming interface. Event handlers consume telemetry and produce controls, while platform-specific backends implement the hardware integration. We implement eleven algorithms and evaluate them in an Ultra Ethernet simulator, UCCL, NVIDIA ConnectX-8, and Microsoft 1P. The results demonstrate portable congestion management at terabit speeds without rewriting policy logic for each device.},
  note        = {Preprint},
  selected={false}
}

@inproceedings{torsiello2026ampel,
  abbr        = {NAIC'26},
  type        = {inproceedings},
  author      = {Valerio Torsiello and Ayush Mishra and Sushovan Das and Lukas R{\"o}llin and Tommaso Bonato and Torsten Hoefler and Laurent Vanbever},
  title       = {Ampel: Scheduling at the Network Cut in ML Training},
  year        = {2026},
  month       = {08},
  tags        = {ai;networking;load balancing;scheduling},
  doi         = {10.1145/3789240.3828736},
  pdf         = {https://www.research-collection.ethz.ch/bitstream/handle/20.500.11850/804300/3789240.3828736.pdf},
  html        = {https://nsg.ee.ethz.ch/publications/2026-08-12-ampel-scheduling-at-the-network-cut-in-ml-training-20-500-11850-804300/},
  abstract    = {Ampel schedules machine-learning training traffic around bottlenecks formed by network cuts. Packet spraying allows the system to simplify the fabric into a model of shared bandwidth constraints, which it combines with coflow scheduling. Simulated workloads show reductions in average training iteration time of up to 18\% over existing ML schedulers.},
  booktitle   = {3rd Workshop on Networks for AI Computing (NAIC), ACM SIGCOMM 2026},
  location    = {Denver, CO, USA},
  highlightnote = {NAIC 2026 Best Paper Award},
  award_name  = {Best Paper},
  award       = {Best Paper Award at the 3rd Workshop on Networks for AI Computing (NAIC), co-located with ACM SIGCOMM 2026 ([publication](https://nsg.ee.ethz.ch/publications/2026-08-12-ampel-scheduling-at-the-network-cut-in-ml-training-20-500-11850-804300/)).},
  selected={true}
}

@inproceedings{pasqualoni2026pico,
  abbr        = {ISC'26},
  type        = {inproceedings},
  author      = {Saverio Pasqualoni and Tommaso Bonato and Lorenzo Piarulli and Torsten Hoefler and Marco Canini and Daniele De Sensi},
  title       = {PICO: Performance Insights for Collective Operations},
  year        = {2026},
  month       = {06},
  tags        = {hpc;ai;networking;collective;performance},
  arxiv       = {https://arxiv.org/abs/2508.16809},
  doi         = {10.48550/arXiv.2508.16809},
  abstract    = {Collective operations are cornerstones of both HPC applications and large-scale AI training and inference, yet benchmarking them in a systematic and reproducible way remains difficult on modern systems due to the complexity of their hardware and software stacks. We present PICO, an open-source framework that decouples portable experiment setup from platform execution, provides a backend-adaptive parameter selection interface across MPI and NCCL, supplies plain-MPI reference collective implementations, and records system configuration for reproducible comparisons. Evaluated on three major supercomputers, PICO shows that default collective algorithms and transport settings can be up to 5x slower than the best available choice. Benchmark-informed tuning with PICO reduces replayed LLM training times by up to 44\%.},
  booktitle   = {ISC High Performance 2026 Research Paper Proceedings (41st International Conference)},
  location    = {Hamburg, Germany},
  highlightnote = {ISC 2026 Hans Meuer Award (Best Paper)},
  award_name  = {Best Paper},
  award       = {ISC High Performance 2026 Hans Meuer Award for the best research paper of the year ([announcement](https://isc-hpc.com/isc-high-performance-announces-hans-meuer-award-and-best-student-paper-award-winners/)).},
  selected={true}
}

@inproceedings{iff2026waferscale,
  abbr        = {DAC'26},
  type        = {inproceedings},
  author      = {Patrick Iff and Tommaso Bonato and Maciej Besta and Luca Benini and Torsten Hoefler},
  title       = {Network Design for Wafer-Scale Systems with Wafer-on-Wafer Hybrid Bonding},
  year        = {2026},
  month       = {07},
  tags        = {networking;hardware;deep learning},
  arxiv       = {https://arxiv.org/abs/2603.05266},
  doi         = {10.1145/3770743.3803957},
  abstract    = {Transformer-based large language models are increasingly constrained by data movement as communication bandwidth drops sharply beyond the chip boundary. Wafer-scale integration using wafer-on-wafer hybrid bonding alleviates this limitation by providing ultra-high bandwidth between reticles on bonded wafers. In this paper, we investigate how the physical placement of reticles on wafers influences the achievable network topology and the resulting communication performance. Starting from a 2D mesh-like baseline, we propose four reticle placements (Aligned, Interleaved, Rotated, and Contoured) that improve throughput by up to 250\%, reduce latency by up to 36\%, and decrease energy per transmitted byte by up to 38\%.},
  booktitle   = {Proceedings of the 63rd ACM/IEEE Design Automation Conference (DAC'26)},
  location    = {Long Beach, CA, USA},
  selected={false}
}

@inproceedings{bonato2026spritz,
  abbr        = {IPDPS'26},
  type        = {inproceedings},
  author      = {Tommaso Bonato and Ales Kubicek and Abdul Kabbani and Ahmad Ghalayini and Maciej Besta and Torsten Hoefler},
  title       = {Spritz: Path-Aware Load Balancing in Low-Diameter Networks},
  year        = {2026},
  month       = {05},
  tags        = {networking;load balancing},
  arxiv       = {https://arxiv.org/abs/2602.19567},
  doi         = {10.48550/arXiv.2602.19567},
  abstract    = {Low-diameter topologies such as Dragonfly and Slim Fly are increasingly adopted in HPC and datacenter networks, yet existing load balancing techniques either rely on proprietary in-network mechanisms or fail to utilize the full path diversity of these topologies. We introduce Spritz, a flexible sender-based load balancing framework that shifts adaptive topology-aware routing to the endpoints using only standard Ethernet features. We propose two algorithms, Spritz-Scout and Spritz-Spray that, respectively, explore and adaptively cache efficient paths using ECN, packet trimming, and timeout feedback. Through simulation on Dragonfly and Slim Fly topologies with over 1000 endpoints, Spritz outperforms ECMP, UGAL-L, and prior sender-based approaches by up to 1.8x in flow completion time under AI training and datacenter workloads, while offering robust failover with performance improvements of up to 25.4x under link failures, all without additional hardware support.},
  booktitle   = {Proceedings of the 40th IEEE International Parallel and Distributed Processing Symposium (IPDPS'26)},
  selected={false}
}

@article{bonato2025smartt,
  abbr        = {arXiv},
  type        = {article},
  author      = {Tommaso Bonato and Abdul Kabbani and Ahmad Ghalayini and Anup Agarwal and Daniele De Sensi and Rong Pan and Costin Raiciu and Mark Handley and Mihai Brodschi and Timo Schneider and Nils Blach and Daniel Santos Ferreira Alves and Torsten Hoefler},
  title       = {SMaRTT: Sender-based Marked Rapidly-adapting Trimmed & Timed Transport},
  year        = {2025},
  tags        = {networking;congestion control;transport},
  arxiv       = {https://arxiv.org/abs/2404.01630},
  doi         = {10.48550/arXiv.2404.01630},
  abstract    = {With the rapid growth of artificial intelligence (AI) workloads in datacenters, the Ultra Ethernet Consortium (UEC) has defined a new high-performance transport layer to deliver the required performance at scale. A core component of this new standard is the Network Signal-based Congestion Control (NSCC) algorithm. This paper presents SMaRTT, the algorithm that forms the basis of the UEC NSCC specification. SMaRTT is a sender-based congestion control algorithm that systematically combines delay, Explicit Congestion Notification (ECN), and optional packet trimming into a cohesive state machine for fast, fair and precise window adjustments with seamless multipath support. At its core lies the novel QuickAdapt algorithm that accurately estimates and rapidly adapts to available capacity. Our evaluation shows that SMaRTT outperforms existing datacenter congestion control algorithms like Swift, RoCE, and MPRDMA by up to 50\% and provides superior fairness, validating the design choices made in the UEC standard.},
  note        = {Preprint},
  selected={false}
}

@article{hu2025demystifying,
  abbr        = {HOTI'25},
  type        = {article},
  author      = {Zhiyi Hu and Siyuan Shen and Tommaso Bonato and Sylvain Jeaugey and Cedell Alexander and Eric Spada and James Dinan and Jeff Hammond and Torsten Hoefler},
  title       = {Demystifying NCCL: An In-depth Analysis of GPU Communication Protocols and Algorithms},
  year        = {2025},
  month       = {08},
  tags        = {ai;networking;collective;nccl},
  url         = {hu-demystifying-nccl.pdf},
  arxiv       = {https://arxiv.org/abs/2507.04786},
  doi         = {10.1109/HOTI66940.2025.00024},
  pages       = {48--59},
  slides      = {hu-demystifying-nccl-slides.pdf},
  abstract    = {The NVIDIA Collective Communication Library (NCCL) is a critical software layer enabling high-performance collectives on large-scale GPU clusters. Despite being open source with a documented API, its internal design remains largely opaque. The orchestration of communication channels, selection of protocols, and handling of memory movement across devices and nodes are not well understood, making it difficult to analyze performance or identify bottlenecks. This paper presents a comprehensive analysis of NCCL, focusing on its communication protocol variants (Simple, LL, and LL128), mechanisms governing intra-node and inter-node data movement, and ring- and tree-based collective communication algorithms. The insights obtained from this study serve as the foundation for ATLAHS, an application-trace-driven network simulation toolchain capable of accurately reproducing NCCL communication patterns in large-scale AI training workloads. By demystifying NCCL's internal architecture, this work provides guidance for system researchers and performance engineers working to optimize or simulate collective communication at scale.},
  publisher   = {IEEE Press},
  booktitle   = {Proceedings of the 32nd Annual Symposium on High-Performance Interconnects (HOTI'25)},
  location    = {Virtual Event},
  selected={false}
}

@inproceedings{desensi2025bine,
  abbr        = {SC'25},
  type        = {inproceedings},
  author      = {Daniele De Sensi and Saverio Pasqualoni and Lorenzo Piarulli and Tommaso Bonato and Seydou Ba and Matteo Turisini and Jens Domke and Torsten Hoefler},
  title       = {Bine Trees: Enhancing Collective Operations by Optimizing Communication Locality},
  year        = {2025},
  month       = {11},
  tags        = {ai;networking;collective;nccl},
  url         = {2025_bine.pdf},
  arxiv       = {https://arxiv.org/abs/2508.17311},
  doi         = {10.1145/3712285.3759835},
  pages       = {1901--1916},
  abstract    = {Communication locality plays a key role in the performance of collective operations on large HPC systems, especially on oversubscribed networks where groups of nodes are fully connected internally but sparsely linked through global connections. We present Bine (binomial negabinary) trees, a family of collective algorithms that improve communication locality. Bine trees maintain the generality of binomial trees and butterflies while cutting global-link traffic by up to 33%. We implement eight Bine-based collectives and evaluate them on four large-scale supercomputers with Dragonfly, Dragonfly+, oversubscribed fat-tree, and torus topologies, achieving up to 5x speedups and consistent reductions in global-link traffic across different vector sizes and node counts.},
  booktitle   = {Proceedings of the International Conference for High Performance Computing, Networking, Storage and Analysis (SC'25)},
  location    = {St. Louis, MO, USA},
  selected={false}
}

