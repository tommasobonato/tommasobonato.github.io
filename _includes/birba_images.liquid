<script>
  window.BIRBA_IMAGES = [
    {%- assign birba_images = site.static_files | where_exp: "file", "file.path contains '/assets/img/birba/'" -%}
    {%- assign valid_images = "" | split: "" -%}
    {%- for file in birba_images -%}
      {%- assign ext = file.extname | downcase -%}
      {%- assign basename = file.basename -%}
      {%- unless file.path contains 'Zone.Identifier' -%}
        {%- unless basename contains '-480' or basename contains '-800' or basename contains '-1400' -%}
          {%- if ext == '.jpg' or ext == '.jpeg' or ext == '.png' or ext == '.gif' or ext == '.webp' -%}
            {%- assign valid_images = valid_images | push: file -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- for file in valid_images -%}
      "{{ file.path | relative_url }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
</script>
